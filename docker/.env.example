# MinIO credentials and retention policy for the WORM audit layer.
#
# Copy to docker/.env and change the password. That file is gitignored and must
# never be staged (see CONTRIBUTING.md, "Secrets — never commit them").

MINIO_ROOT_USER=fsadmin
MINIO_ROOT_PASSWORD=change-me-before-first-run

# Object-lock retention applied to the raw/ bucket.
#
# GOVERNANCE  a user holding s3:BypassGovernanceRetention can still delete.
#             Recoverable. This is the default here on purpose.
# COMPLIANCE  NOBODY can delete before the period expires -- not an admin, not
#             root, not by deleting the bucket. The disk is committed for the
#             full retention window. This is the production intent per
#             context/storage.md, but set it only when you mean it.
RAW_RETENTION_MODE=GOVERNANCE
RAW_RETENTION_DAYS=3650

# Where the lake lives. raw/ is immutable source drops; lake/ is DuckLake's
# managed Parquet and must stay writable -- see docker-compose.yml.
MINIO_RAW_BUCKET=raw
MINIO_LAKE_BUCKET=lake
