# Copy to .env in this folder and set real values before `docker compose up`.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# How long source drops in raw/ stay immutable (WORM). COMPLIANCE mode means
# not even the root user can delete them before this elapses. 3650 = ~10 years.
RAW_RETENTION_DAYS=3650
