# src/nodejs/.env — copy to `.env` and edit. The real file is GITIGNORED and
# must never be staged. Run the secret guard before every commit:
#   git diff --cached --name-only | grep -E '\.env$|today\.xml|data/raw/'

# --- ports -------------------------------------------------------------------
PORT=4044

# HTTPS listener. 4024 rather than 4443 because that port is already forwarded
# on the router. Omit, or delete the certs, and the API serves http only.
API_TLS_PORT=4024

# --- data root ---------------------------------------------------------------
# Where the API looks for data/. Leave UNSET for a normal checkout — it is
# derived from the file layout (src/nodejs/src/paths.js) and is correct both
# when running from source and from the bundle.
#
# Set it to point at a different tree without touching code: a snapshot
# restored from Drive, a second disk, someone else's export. Absolute path, and
# it must contain a data/ directory or the API exits at startup rather than
# silently serving empty screens.
#
# Windows paths: forward slashes are fine and avoid escaping headaches.
# FS_DATA_ROOT=C:/Users/PC/Desktop/CLAUDE2/Fundamental-Screener
# FS_DATA_ROOT=D:/restored/data-20260809_T_185818

# --- screener.in login -------------------------------------------------------
# Required for full-text search (Firms & Asset Managers). Without these,
# authedFetch returns null and the search route 500s.
#
# QUOTE THE PASSWORD. Node's .env parser treats an unquoted '#' as a comment,
# so a password starting with '#' silently arrives as undefined. Single quotes
# also stop '$' being read as interpolation.
SCREENER_EMAIL=you@example.com
SCREENER_PASSWORD='your#password$here'

# --- CORS --------------------------------------------------------------------
# Browser-facing allowlist. The Vercel proxy is same-origin so it is unaffected;
# this covers anything hitting the API directly. '*' would re-open it to every
# site, so keep it explicit.
API_ALLOW_ORIGIN=https://your-app.vercel.app,https://*.vercel.app,http://localhost:3001

# --- logging -----------------------------------------------------------------
# Request log. Set to 0 to silence. An explicit 0 is honoured (it is not
# treated as "unset"), which an earlier `Number(x) || default` got wrong.
API_LOG=1
