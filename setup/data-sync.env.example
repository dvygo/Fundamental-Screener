# Copy to `.data-sync.env` at the REPO ROOT (not into setup/). That file is
# gitignored; this example is committed. Precedence: real env vars win, then
# .data-sync.env, then the defaults baked into src/python/data_sync.py.
#
# Check what actually resolved, without printing any secret:
#   python src/python/data_sync.py config

# --- Google Drive (rclone) ---------------------------------------------------
# Service-account JSON key. A SECRET: gitignored, copied to each machine by
# hand, never committed. Only its PATH is passed to rclone; the key itself is
# never printed or logged.
FS_RCLONE_SA_FILE=C:/Users/PC/Desktop/CLAUDE2/Fundamental-Screener/fundamental-screener-XXXXXX.json

# Shared-drive (team drive) id. An identifier, not a credential — safe to ship.
FS_RCLONE_DRIVE_ID=0AP0BEyLWWv-zUk9PVA

# Optional parent folder for the archives. Empty = drive root, where snapshots
# land as top-level data-<timestamp>.tar.gz.
FS_RCLONE_REMOTE_ROOT=

# --- rclone binary -----------------------------------------------------------
# data_sync.py finds rclone with shutil.which, so it must be on PATH. Installed
# via winget it may have NO shim in WinGet\Links, in which case `config` reports
# rclone=MISSING and you prefix PATH for the run:
#
#   set PATH=C:\Users\PC\AppData\Local\Microsoft\WinGet\Packages\Rclone.Rclone_Microsoft.Winget.Source_8wekyb3d8bbwe\rclone-v1.74.4-windows-amd64;%PATH%
#
# Verify BEFORE a 1 GB upload:  python src/python/data_sync.py config
