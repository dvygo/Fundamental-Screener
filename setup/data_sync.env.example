# data_sync config — copy to  <repo>/.data-sync.env  (gitignored) to override the
# defaults in src/python/data_sync.py. Every line is optional; env vars win over
# this file, which wins over the built-in defaults.

# Path to the Google service-account JSON key. SECRET — never commit it; copy it
# to each server's root by hand. Default: <repo>/fundamental-screener-*.json.
# FS_RCLONE_SA_FILE=/root/fundamental-screener-503703-e380e2e89533.json

# Shared-drive (team drive) id. Default is the "Fundamental-Screener" drive.
# Find it with:  python src/python/data_sync.py drives
# FS_RCLONE_DRIVE_ID=0AP0BEyLWWv-zUk9PVA

# Optional parent folder in the drive for the data-<timestamp> snapshots.
# Default: empty = drive root, so snapshots are top-level  data-YYYYMMDD_T_HHMMSS.
# FS_RCLONE_REMOTE_ROOT=
